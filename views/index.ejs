
<!-- include header -->
    <%- include('include/_header') %>

<!-- /include header -->


    <!-- Main Site -->
    <main id="site-main">
        <div class="container">

            <div class="box-nav d-flex justify-between">
                <a href="/add-food" class="border-shadow">
                    <span class="text-gradient">New Recette <i class="fas fa-food"></i></span>
                </a>
            </div>

            <!-- form handling -->
            <form action="/" method="POST">
                <table class="table">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>Menu</th>
                            <th>Composant</th>
                            <th>Type</th>
                            <th>Extras</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%- include('include/_show') %>
                    </tbody>
                </table>
            </form>
        </div>
    </main>
<!-- /Main Site -->


<!-- include footer -->
<%- include('include/_footer') %>
<!-- /include footer -->